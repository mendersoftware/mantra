{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":gitSignOff"
  ],

  "reviewersFromCodeOwners": true,

  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",

  "rebaseWhen": "conflicted",

  "prHourlyLimit": 2,
  "prConcurrentLimit": 20,

  "baseBranchPatterns": ["master"],

  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },

  "packageRules": [
    {
      "matchManagers": ["gitlabci", "gitlabci-include"],
      "semanticCommitType": "ci",
      "semanticCommitScope": ""
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "development-dependencies",
      "groupSlug": "development-dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "production-dependencies",
      "groupSlug": "production-dependencies"
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "python-backend-dependencies",
      "groupSlug": "python-backend-dependencies"
    }
  ]
}
